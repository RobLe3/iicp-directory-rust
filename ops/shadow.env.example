# IICP Rust persistent-shadow configuration template.
# Copy outside the repository, set mode 0600, and replace every REQUIRED value.
# Never reuse Genesis database credentials, APP_KEY, signing material, or DID.

APP_ENV=production
DATABASE_URL=REQUIRED_SEPARATE_SHADOW_MYSQL_DSN
APP_KEY=REQUIRED_UNIQUE_SHADOW_HS256_KEY
IICP_GENESIS_ED25519_SECRET_KEY=REQUIRED_UNIQUE_128_HEX_SHADOW_ED25519_SECRET

IICP_REPLICA_MODE=true
IICP_SEED_URL=https://iicp.network
IICP_REPLICA_DID=REQUIRED_DISTINCT_SHADOW_DID
IICP_REPLICA_ENDPOINT=REQUIRED_SHADOW_HTTPS_ENDPOINT
IICP_REPLICA_POLL_SECS=10

IICP_DEPLOYMENT_KIND=container
IICP_RELEASE_TAG=v0.1.3
IICP_SOURCE_COMMIT=REQUIRED_40_HEX_RELEASE_COMMIT
IICP_BUILD_ID=REQUIRED_SHA256_RELEASE_ARTIFACT_DIGEST
IICP_DEPLOYED_AT=REQUIRED_RFC3339_UTC_TIME
IICP_ROOT_KEY_ID=REQUIRED_SHADOW_DID_KEY_ID
IICP_OPENAPI_VERSION=1.6.0
IICP_PROTOCOL_MIN=1.9.0
IICP_PROTOCOL_MAX=1.9.0

# Production must not set either development bypass.
# IICP_DEV_ALLOW_INSECURE_TLS=
# IICP_DEV_ALLOW_UNSIGNED_EVENTS=
